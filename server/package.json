{
	"name": "@gestione-eventi-parrocchia/server",
	"private": true,
	"module": "src/index.ts",
	"type": "module",
	"version": "0.0.1",
	"exports": {
		".": "./src/index.ts",
		"./orpc": "./src/orpc/index.ts",
		"./orpc/types": "./src/orpc/types.ts",
		"./client": "./src/client-exports.ts"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"check-types": "tsc --noEmit",
		"db:pull": "drizzle-kit pull",
		"db:push": "drizzle-kit push",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:seed": "bun run scripts/seed.ts",
		"db:reset": "bun run scripts/reset-and-seed.ts",
		"db:drop": "drizzle-kit drop",
		"db:studio": "drizzle-kit studio",
		"create-org": "bun run scripts/create-organization.ts",
		"create-supreme-admin": "bun run scripts/create-supreme-admin.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.2.20",
		"@types/node": "^24.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20250816.1",
		"drizzle-kit": "^0.31.4",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/static": "^1.3.0",
		"@elysiajs/swagger": "^1.3.1",
		"@google/generative-ai": "^0.24.1",
		"@libsql/client": "^0.15.11",
		"@orpc/server": "^1.8.1",
		"@orpc/zod": "^1.8.1",
		"@sinclair/typebox": "^0.34.40",
		"@tqman/nice-logger": "^1.1.1",
		"@trpc/server": "^11.4.4",
		"ai": "^4.3.19",
		"better-auth": "^1.3.6",
		"dotenv": "^17.2.1",
		"drizzle-orm": "^0.44.4",
		"drizzle-typebox": "^0.3.3",
		"elysia": "^1.3.8",
		"logixlysia": "^5.1.0",
		"nanoid": "^5.1.5",
		"ollama-ai-provider": "^1.2.0",
		"openai": "^5.12.2",
		"pg": "^8.16.3",
		"picocolors": "^1.1.1",
		"zod": "^3.25.76"
	},
	"overrides": {
		"@sinclair/typebox": "0.32.4"
	}
}
